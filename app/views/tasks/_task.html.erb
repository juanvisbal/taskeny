<%= turbo_frame_tag dom_id(task) do %>
  <li>
    <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm bg-white dark:bg-gray-800 flex items-start justify-between gap-4">
      <div class="flex items-start gap-2 flex-grow">
        <%= button_to toggle_task_path(task), method: :patch, class: "mt-1 flex-shrink-0", form: { data: { turbo_frame: dom_id(task) } } do %>
          <div class="w-5 h-5 rounded-full border-2 <%= task.completed ? 'bg-green-500 border-green-500' : 'border-gray-300 dark:border-gray-500' %> flex items-center justify-center">
            <% if task.completed %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        <% end %>

        <div class="flex-grow flex flex-col lg:flex-row items-baseline gap-2">
          <div class="flex-grow flex flex-col items-start space-y-2 hyphens-auto">
            <h3 class="text-lg font-medium dark:text-white <%= 'line-through text-gray-500 dark:text-gray-400' if task.completed %>">
              <%= task.title %>
            </h3>

            <% if task.description.present? %>
              <p class="text-gray-600 dark:text-gray-300 mt-1 <%= 'line-through text-gray-400 dark:text-gray-500' if task.completed %>">
                <%= task.description %>
              </p>
            <% end %>
          </div>

          <div class="flex items-center space-x-2">
            <% if defined?(task.priority) && task.priority.present? %>
              <%= priority_badge(task.priority) %>
            <% end %>

            <% if defined?(task.due_date) && task.due_date.present? %>
              <span class="text-sm text-gray-500 dark:text-gray-400">
                <%= task.due_date.strftime("%b %d") %>
                <% if defined?(task.overdue?) && task.overdue? %>
                  <span class="text-red-600 dark:text-red-400 ml-1">(Overdue)</span>
                <% end %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex gap-2">
        <%= link_to edit_task_path(task),
            class: "h-8 w-8 flex items-center justify-center text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200",
            data: { turbo_frame: "modal" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
          </svg>
        <% end %>

        <%= button_to task_path(task),
            method: :delete,
            class: "h-8 w-8 flex items-center justify-center text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400",
            form: { data: { turbo_confirm: "Are you sure you want to delete this task?" } } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    </div>
  </li>
<% end %>
