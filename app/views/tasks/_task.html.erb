<%= turbo_frame_tag dom_id(task) do %>
  <div class="p-4 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
    <div class="flex items-start justify-between">
      <div class="flex items-start space-x-3">
        <%= button_to toggle_task_path(task), 
            method: :patch, 
            class: "mt-1" do %>
          <% if task.completed %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          <% else %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
            </svg>
          <% end %>
        <% end %>
        
        <div class="flex-1">
          <h3 class="text-lg font-semibold <%= task.completed ? 'line-through text-gray-500 dark:text-gray-400' : 'dark:text-white' %>">
            <%= task.title %>
          </h3>
          <% if task.description.present? %>
            <p class="mt-1 text-gray-600 dark:text-gray-300 <%= task.completed ? 'line-through' : '' %>">
              <%= task.description %>
            </p>
          <% end %>
        </div>
      </div>
      
      <div class="flex space-x-2">
        <%= link_to edit_task_path(task), 
            class: "text-blue-500 hover:text-blue-700",
            data: { turbo_frame: "modal" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
          </svg>
        <% end %>
        
        <%= button_to task_path(task),
            method: :delete,
            class: "text-red-500 hover:text-red-700",
            data: { turbo_confirm: "Are you sure you want to delete this task?" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>
<% end %>