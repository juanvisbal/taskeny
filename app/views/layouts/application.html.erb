<!DOCTYPE html>
<html lang="en" data-theme="light" data-controller="a11y">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : "Taskeny" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Favicon and Apple Touch Icons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" crossorigin="anonymous">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" crossorigin="anonymous">
  <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" crossorigin="anonymous">
  <link rel="shortcut icon" href="/icons/favicon.ico" crossorigin="anonymous">
  <link rel="manifest" href="/manifest.json" crossorigin="anonymous">
  <meta name="application-name" content="Taskeny">
  <meta name="theme-color" content="#ffffff">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Taskeny">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">

  <%# Preload and include all stylesheet files in app/assets/stylesheets %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload", rel: :preload, as: 'style' %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen flex flex-col">
  <!-- Skip to main content link -->
  <a href="#main-content" 
     class="skip-link sr-only focus:not-sr-only focus:absolute focus:p-4 focus:bg-blue-600 focus:text-white focus:z-50"
     data-a11y-target="skipLink"
     data-action="click->a11y#skipToContent">
    Skip to main content
  </a>
  
  <!-- Screen reader announcements -->
  <div aria-live="polite" 
       class="sr-only" 
       data-a11y-target="announcer">
  </div>

  <header class="bg-white dark:bg-gray-800 shadow-sm" role="banner">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center">
        <%= image_tag "icon-192.png", class: "h-8 w-8 mr-2", alt: "Taskeny logo" %>
        <h1 class="text-2xl font-bold text-blue-600 dark:text-blue-400">Taskeny</h1>
      </div>

      <button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700" data-controller="theme" data-action="click->theme#toggle" aria-label="Toggle dark/light theme">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 dark:hidden" viewBox="0 0 20 20" fill="currentColor">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden dark:block text-yellow-300" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </header>

  <div id="flash-messages" class="container mx-auto px-4 py-4">
    <% flash.each do |type, message| %>
      <div class="<%= type == 'notice' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700' %> px-4 py-3 rounded relative border mb-4" role="alert" data-controller="flash">
        <span class="block sm:inline"><%= message %></span>
        <button type="button" class="absolute top-0 bottom-0 right-0 px-4 py-3" data-action="flash#dismiss" aria-label="Close message">
          <svg class="fill-current h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>

  <main id="main-content" role="main" class="container mx-auto px-4 pb-10 flex-grow">
    <%= yield %>
  </main>

  <footer role="contentinfo" class="bg-white dark:bg-gray-800 py-6 mt-10">
    <div class="container mx-auto px-4">
      <p class="text-center text-gray-600 dark:text-gray-400">&copy; <%= Date.current.year %> Taskeny. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>