  <div id="flash" class="fixed top-20 left-1/2 transform -translate-x-1/2 z-50 flex flex-col items-center gap-4">
    <% flash.each do |type, message| %>
      <div class="<%= type == 'notice' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700' %> flex items-start px-4 py-3 rounded relative border transition-opacity duration-300 flash-message max-w-screen"
          role="alert"
          data-controller="flash"
          data-action="animationend->flash#remove">
        <% if type == 'notice' %>
          <svg class="h-6 w-6 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        <% else %>
          <svg class="h-6 w-6 text-yellow-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        <% end %>
        <div class="mr-6">
          <p class="<%= type == 'notice' ? 'text-green-800' : 'text-yellow-800' %>">
            <%= message %>
          </p>
        </div>
        <button
          data-action="flash#remove"
          class="<%= type == 'notice' ? 'text-green-700 hover:text-green-900' : 'text-yellow-700 hover:text-yellow-900' %> cursor-pointer h-6 w-6 flex-shrink-0 flex items-center justify-center">
          <span class="text-2xl">&times;</span>
        </button>
      </div>
    <% end %>
  </div>
